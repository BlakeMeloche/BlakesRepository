import random

#initial variables
playerScore = 0
botScore = 0
playRound = 0
playerChoice = 0
botChoice = 0
reset = False
playing = "false"
timer = 60
botName = "Jeff"
speedMode = ""
playingAgain = "false"
playAgain = 0
textChoice = 0
scene = 0
currentSpeedMode = ""

#Starts the menu stage, only changes to next stage of the game if you type normal or instant
def menu(stage):
    #global allows it to modify but not take the variable for itself
    global scene, speedMode
    #setup is only applied if you're not playing again
    if playAgain == 0:
        #only happens once or if you typed something wrong
        if stage == 0:
            print("Lets start with a quick setup.")
            speedMode = input("How fast would you like the game to resolve? Type either instant or normal then press enter.    ")
            if speedMode in ("normal", "instant"):
                stage += 1
        #makes it so stage 0 never happens again
        if stage == 1:
            print("Alright, good luck!")
            scene += 1
    #logic for if you are playing again so that it doesn't require setup multiple times in one session
    if playAgain == 1:
        speedMode = currentSpeedMode
        scene += 1

#presets the bot's choice every round
def bot():
    global scene, botChoice
    botChoice = random.randint(1,3)
    scene += 1
#player chooses what they want based on the three choices then scene moves to resolution
def play():
    global textChoice, playerChoice, scene
    textChoice = input("Type rock, paper, or scissors then press enter for your choice!")
    if textChoice == "rock":
        playerChoice = 1
    elif textChoice == "paper":
        playerChoice = 2
    elif textChoice == "scissors":
        playerChoice = 3
    scene += 1
    #theres a couple lines saying rock paper scissors before you get result, but only if normal speedMode is chosen
def resolve(phase):
    global playerScore, playAgain, textChoice, scene, currentSpeedMode, botScore, playRound,playerChoice, botChoice, reset, playing, timer, botName, speedMode, playingAgain
    if speedMode == "instant":
        phase = 2
    if speedMode == "normal":
        if timer >= 1:
            if timer == 60:
                print("Rock...")
            timer -= 1
            if timer == 40:
                print("Paper...")
            if timer == 20:
                print("Scissors...")
            if timer == 0:
                print("Shoot!")
                phase = 2
    #phase change stops the timer from spamming rock infinitely pretty much
    if phase ==  2:
        #reset sets timer back to 60 soon
        reset = True
        #results in the if statements, phase change stops the scores from going up forever once score 2 is reached
        if playerChoice == 1 and botChoice == 1 or playerChoice == 2 and botChoice == 2 or playerChoice == 3 and botChoice == 3:
            print("Its a tie!")
            if reset == True:
                timer = 60
                reset == False
            phase = 3
        if playerChoice == 1 and botChoice == 3 or playerChoice == 2 and botChoice == 1 or playerChoice == 3 and botChoice == 2:
            print("You win!")
            playerScore += 1
            if reset == True:
                timer = 60
                reset == False
            phase = 3
        if playerChoice == 1 and botChoice == 2 or playerChoice == 2 and botChoice == 3 or playerChoice == 3 and botChoice == 1:
            print("You lose!")
            botScore += 1
            if reset == True:
                timer = 60
                reset == False
            phase = 3
    if phase == 3:
        #prints integers as part of the string
        print(f"Your score is {playerScore} And the bots score is {botScore}.")
        #plays again automatically if nobody has reached score 2, or otherwise resets all variables completely
        #except for speedMode through the currentSpeedMode variable
        if playerScore <= 1 and botScore <= 1:
            scene = 1
        if playerScore == 2:
            playingAgain = input("You win best out of 3! Would you like to play again with scores starting at 0? Type yes or no then press enter to continue.")
            if playingAgain == "yes":
                currentSpeedMode = speedMode
                playAgain = 1
                playerScore = 0
                botScore = 0
                playRound = 0
                playerChoice = 0
                botChoice = 0
                reset = "false"
                playing = "false"
                timer = 60
                botName = "Jeff"
                speedMode = ""
                playingAgain = "false"
                textChoice = 0
                scene = 0
        if botScore == 2:
            playingAgain = input("You lose best out of 3! Would you like to play again with scores starting at 0? Type yes or no then press enter to continue.")
            if playingAgain == "yes":
                currentSpeedMode = speedMode
                playAgain = 1
                playerScore = 0
                botScore = 0
                playRound = 0
                playerChoice = 0
                botChoice = 0
                reset = "false"
                playing = "false"
                timer = 60
                botName = "Jeff"
                speedMode = ""
                playingAgain = "false"
                textChoice = 0
                scene = 0
#This runs functions and allows game looping!
while True:              
    if scene == 0:
        menu(0)
    if scene == 1:
        bot()
    if scene == 2:
        play()
    if scene == 3:
        resolve(0)

#thats all folks
